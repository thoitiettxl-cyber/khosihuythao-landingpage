---
import { joinBase } from "../utils/config";

interface Props {
  alt: string;
  class?: string;
  eager?: boolean;
  image: string;
  sizes?: string;
}

const {
  alt,
  class: className,
  eager = false,
  image,
  sizes = "(max-width: 720px) 90vw, 480px",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const imagePath = (format: "avif" | "webp", width: 480 | 960) =>
  joinBase(base, `/images/${image}-${width}.${format}`);
---

<picture>
  <source
    type="image/avif"
    srcset={`${imagePath("avif", 480)} 480w, ${imagePath("avif", 960)} 960w`}
    {sizes}
  />
  <source
    type="image/webp"
    srcset={`${imagePath("webp", 480)} 480w, ${imagePath("webp", 960)} 960w`}
    {sizes}
  />
  <img
    src={imagePath("webp", 960)}
    width="960"
    height="960"
    {alt}
    class={className}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding={eager ? "sync" : "async"}
  />
</picture>
