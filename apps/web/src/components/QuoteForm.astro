---
import { business } from "../config/business";

const hasTurnstile = !business.turnstileSiteKey.includes("TODO");
---

<form
  id="quote-form"
  class="quote-form"
  data-api-url={business.apiUrl}
  novalidate
>
  <div class="form-grid">
    <div class="field">
      <label for="name">Họ tên <span aria-hidden="true">*</span></label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="80"
        aria-describedby="name-error"
      />
      <span id="name-error" class="field-error" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for="phone">Số điện thoại <span aria-hidden="true">*</span></label>
      <input
        id="phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        maxlength="24"
        aria-describedby="phone-error"
      />
      <span id="phone-error" class="field-error" aria-live="polite"></span>
    </div>
    <div class="field field-wide">
      <label for="message"
        >Nội dung cần mua <span aria-hidden="true">*</span></label
      >
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        maxlength="1000"
        aria-describedby="message-error"
        placeholder="Ví dụ: Cần lưỡi cắt kính 105 mm, số lượng 20"></textarea>
      <span id="message-error" class="field-error" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for="quantity"
        >Số lượng <span class="optional">(tùy chọn)</span></label
      >
      <input
        id="quantity"
        name="quantity"
        type="text"
        inputmode="numeric"
        maxlength="40"
      />
    </div>
    <div class="field">
      <label for="area"
        >Khu vực giao hàng <span class="optional">(tùy chọn)</span></label
      >
      <input
        id="area"
        name="area"
        type="text"
        autocomplete="address-level2"
        maxlength="120"
      />
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for="company">Công ty</label>
      <input
        id="company"
        name="company"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
  </div>
  {
    hasTurnstile ? (
      <div id="quote-turnstile" data-sitekey={business.turnstileSiteKey} />
    ) : (
      <p class="preview-note">
        Turnstile đang tắt trong bản phát triển. Production build yêu cầu site
        key thật.
      </p>
    )
  }
  <div class="form-actions">
    <button class="button button-accent" type="submit"
      >Gửi yêu cầu báo giá</button
    >
    <div class="form-zalo-links" aria-label="Gửi ảnh qua Zalo">
      <span>Cần gửi ảnh?</span>
      {
        business.contacts.map((contact) => (
          <a
            class="text-link"
            href={contact.zaloUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Zalo {contact.phoneDisplay}
          </a>
        ))
      }
    </div>
  </div>
  <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
</form>

{
  hasTurnstile && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      is:inline
      async
      defer
    />
  )
}

<script>
  import { validateLeadInput } from "@landingpage/shared";

  declare global {
    interface Window {
      quoteTurnstileWidgetId?: string;
      turnstile?: {
        render: (container: Element, options: { sitekey: string }) => string;
        reset: (widgetId: string) => void;
      };
    }
  }

  const form = document.querySelector<HTMLFormElement>("#quote-form");
  const status = document.querySelector<HTMLElement>("#form-status");
  const turnstileContainer =
    document.querySelector<HTMLElement>("#quote-turnstile");
  const turnstileScript = document.querySelector<HTMLScriptElement>(
    'script[src*="challenges.cloudflare.com/turnstile"]',
  );

  function renderTurnstile(): void {
    const sitekey = turnstileContainer?.dataset.sitekey;
    if (
      !turnstileContainer ||
      !sitekey ||
      !window.turnstile ||
      window.quoteTurnstileWidgetId
    ) {
      return;
    }
    window.quoteTurnstileWidgetId = window.turnstile.render(
      turnstileContainer,
      { sitekey },
    );
  }

  turnstileScript?.addEventListener("load", renderTurnstile, { once: true });
  renderTurnstile();

  function showFieldErrors(errors: Record<string, string>): void {
    for (const name of ["name", "phone", "message"]) {
      const input = document.querySelector<
        HTMLInputElement | HTMLTextAreaElement
      >(`#${name}`);
      const output = document.querySelector<HTMLElement>(`#${name}-error`);
      const message = errors[name] ?? "";
      if (output) output.textContent = message;
      if (input) input.setAttribute("aria-invalid", message ? "true" : "false");
    }
  }

  function apiErrorCode(value: unknown): string | undefined {
    if (typeof value !== "object" || value === null || !("error" in value)) {
      return undefined;
    }
    const error = value.error;
    if (typeof error !== "object" || error === null || !("code" in error)) {
      return undefined;
    }
    return typeof error.code === "string" ? error.code : undefined;
  }

  function resetTurnstile(): void {
    const widgetId = window.quoteTurnstileWidgetId;
    if (widgetId && window.turnstile) window.turnstile.reset(widgetId);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    void (async () => {
      if (!form || !status) return;
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      if (button?.disabled) return;

      const values = new FormData(form);
      const payload = {
        name: values.get("name"),
        phone: values.get("phone"),
        message: values.get("message"),
        quantity: values.get("quantity"),
        area: values.get("area"),
        company: values.get("company"),
        source: "landing-page",
        turnstileToken: values.get("cf-turnstile-response") ?? "",
      };
      const validation = validateLeadInput(payload);
      if (!validation.ok) {
        showFieldErrors(validation.fieldErrors);
        status.textContent = "Vui lòng kiểm tra các trường được đánh dấu.";
        document.querySelector<HTMLElement>("[aria-invalid='true']")?.focus();
        return;
      }

      showFieldErrors({});
      if (button) {
        button.disabled = true;
        button.textContent = "Đang gửi…";
      }
      status.textContent = "Đang gửi yêu cầu…";

      try {
        const response = await fetch(`${form.dataset.apiUrl ?? ""}/api/lead`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result: unknown = await response.json();
        const errorCode = apiErrorCode(result);
        if (response.status === 429 || errorCode === "RATE_LIMITED") {
          status.textContent =
            "Bạn đã gửi nhiều yêu cầu liên tiếp. Vui lòng chờ một phút rồi thử lại.";
          return;
        }
        if (errorCode === "TURNSTILE_FAILED") {
          status.textContent =
            "Phiên xác minh đã hết hạn. Vui lòng xác minh lại rồi gửi yêu cầu.";
          return;
        }
        if (
          !response.ok ||
          typeof result !== "object" ||
          result === null ||
          !("message" in result)
        ) {
          throw new Error("Yêu cầu không thành công.");
        }
        status.textContent =
          typeof result.message === "string"
            ? result.message
            : "Đã nhận yêu cầu.";
        form.reset();
      } catch {
        status.textContent =
          "Chưa thể gửi yêu cầu. Vui lòng gọi điện hoặc nhắn Zalo để được hỗ trợ.";
      } finally {
        resetTurnstile();
        if (button) {
          button.disabled = false;
          button.textContent = "Gửi yêu cầu báo giá";
        }
      }
    })();
  });
</script>
