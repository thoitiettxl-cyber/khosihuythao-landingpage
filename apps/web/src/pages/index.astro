---
import QuoteForm from "../components/QuoteForm.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { business, hasBusinessPlaceholders } from "../config/business";
import { faq } from "../data/faq";
import { products } from "../data/products";
import { benefits, orderSteps, trustPoints } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase } from "../utils/config";

const title = `${business.name} | Kho sỉ vật tư tại TP. Hồ Chí Minh`;
const description =
  "Kho sỉ vật tư, dụng cụ sơn và hàng thi công. Gửi yêu cầu nhanh, nhận tại kho hoặc giao chành xe toàn quốc.";
const gallery = products.map((product) => ({
  image: product.image,
  alt: product.name,
}));
---

<BaseLayout {title} {description}>
  {
    hasBusinessPlaceholders && (
      <div class="preview-banner" role="status">
        Bản xem trước — thông tin liên hệ thật chưa được cấu hình, không dùng để
        đặt hàng production.
      </div>
    )
  }
  <header class="site-header">
    <div class="container header-inner">
      <a
        class="brand"
        href="#top"
        aria-label={`${business.name} — về đầu trang`}
      >
        <span class="brand-mark" aria-hidden="true">HT</span>
        <span
          ><strong>{business.name}</strong><small>{business.slogan}</small
          ></span
        >
      </a>
      <div class="header-actions">
        <a class="text-link" href="#products">Xem hàng thực tế</a>
        <a class="button button-accent" href="#quote">Gửi yêu cầu</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Kho sỉ vật tư tại TP. Hồ Chí Minh</p>
          <h1>Hỏi nhanh. Báo giá gọn. Giao chành xe toàn quốc.</h1>
          <p class="hero-lead">
            Gửi tên, hình ảnh hoặc quy cách mặt hàng cần tìm. Kho Sỉ Huy Thảo
            kiểm tra nhu cầu và chủ động liên hệ lại với bạn.
          </p>
          <div class="hero-actions">
            <a class="button button-accent button-large" href="#quote"
              >Gửi yêu cầu báo giá</a
            >
            {
              business.contacts.map((contact) => (
                <a
                  class="button button-navy button-large"
                  href={contact.zaloUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Zalo {contact.phoneDisplay}
                </a>
              ))
            }
          </div>
          <p class="service-note">
            <strong>{business.serviceArea}</strong>
          </p>
        </div>
        <div class="hero-visual">
          <ResponsiveImage
            image="03-warehouse-cartons-x2000"
            alt="Các thùng vật tư X2000 trong kho"
            eager
            sizes="(max-width: 760px) 92vw, 46vw"
          />
          <div class="hero-badge">
            <strong>Hàng tại kho</strong><span
              >Liên hệ trước khi đến lấy hàng</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Điểm hỗ trợ">
      <div class="container trust-grid">
        {
          trustPoints.map((point, index) => (
            <p>
              <span aria-hidden="true">0{index + 1}</span>
              {point}
            </p>
          ))
        }
      </div>
    </section>

    <section
      id="products"
      class="section section-tinted"
      aria-labelledby="products-title"
    >
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Hình ảnh tại kho</p><h2 id="products-title">
              Một số mặt hàng thực tế
            </h2>
          </div>
          <p>
            Hình ảnh dùng để minh họa hàng kho. Không tự động liên kết bảng giá
            hoặc suy đoán tồn kho.
          </p>
        </div>
        <div class="product-grid">
          {
            products.map((product) => (
              <article class="product-card">
                <div class="product-image">
                  <ResponsiveImage image={product.image} alt={product.name} />
                </div>
                <div class="card-body">
                  <p class="status-chip">Ảnh minh họa thực tế</p>
                  <>
                    <h3>{product.name}</h3>
                    <p>{product.use}</p>
                  </>
                  <div class="product-footer">
                    <>
                      <strong>Cần mặt hàng tương tự?</strong>
                      <a class="icon-link" href="#quote">
                        Gửi yêu cầu <span aria-hidden="true">→</span>
                      </a>
                    </>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="policy" class="section" aria-labelledby="benefits-title">
      <div class="container benefit-layout">
        <div class="benefit-intro">
          <p class="eyebrow">Hỗ trợ thực tế</p><h2 id="benefits-title">
            Một yêu cầu, một mục tiêu rõ ràng
          </h2><p>
            Để lại thông tin để kho chủ động liên hệ, hoặc chọn đúng số Zalo nếu
            bạn cần gửi ảnh sản phẩm.
          </p><a class="button button-navy" href="#quote">Nhận tư vấn</a>
        </div>
        <div class="benefit-grid">
          {
            benefits.map((benefit, index) => (
              <article>
                <>
                  <span aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.text}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section gallery-section" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Kho &amp; hàng hóa</p><h2 id="gallery-title">
              Xem gần hơn sản phẩm thực tế
            </h2>
          </div><p>
            Chọn một hình để mở bản lớn. Ảnh gốc được giữ nguyên nhãn sản phẩm.
          </p>
        </div>
        <div class="gallery-grid">
          {
            gallery.map((item) => (
              <button
                class="gallery-item"
                type="button"
                data-lightbox-src={joinBase(
                  import.meta.env.BASE_URL,
                  `/images/${item.image}-960.webp`,
                )}
                data-lightbox-alt={item.alt}
                aria-label={`Mở ảnh lớn: ${item.alt}`}
              >
                <>
                  <ResponsiveImage image={item.image} alt={item.alt} />
                  <span>
                    Xem ảnh <span aria-hidden="true">↗</span>
                  </span>
                </>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="delivery"
      class="section process-section"
      aria-labelledby="process-title"
    >
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Quy trình</p><h2 id="process-title">
              Gửi nhu cầu trong 3 bước
            </h2>
          </div><p>
            Không cần tài khoản và không thanh toán trên landing page.
          </p>
        </div>
        <ol class="process-grid">
          {
            orderSteps.map((step) => (
              <li>
                <>
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="quote"
      class="section quote-section"
      aria-labelledby="quote-title"
    >
      <div class="container quote-layout">
        <div class="quote-copy">
          <p class="eyebrow">Yêu cầu báo giá</p><h2 id="quote-title">
            Cho cửa hàng biết bạn đang cần gì
          </h2><p>
            Cung cấp tên hoặc mô tả sản phẩm, số lượng và khu vực nhận hàng. Kho
            sẽ chủ động liên hệ theo số điện thoại bạn cung cấp.
          </p><ul>
            <li>Không yêu cầu thanh toán trên form.</li><li>
              Thông tin chỉ dùng để phản hồi yêu cầu của bạn.
            </li><li>Form được bảo vệ chống spam bằng Cloudflare Turnstile.</li>
          </ul>
        </div>
        <QuoteForm />
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <div>
          <p class="eyebrow">Câu hỏi thường gặp</p><h2 id="faq-title">
            Thông tin trước khi liên hệ
          </h2>
        </div><div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="brand brand-footer" href="#top"
          ><span class="brand-mark" aria-hidden="true">HT</span><span
            ><strong>{business.name}</strong><small>{business.slogan}</small
            ></span
          ></a
        ><p>{business.legalName}</p><p>Kho sỉ vật tư — phục vụ nhanh gọn.</p>
      </div>
      <div>
        <h2>Liên hệ</h2>
        {
          business.contacts.map((contact) => (
            <p class="footer-contact">
              <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
              <a
                href={contact.zaloUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Zalo
              </a>
            </p>
          ))
        }
        <p>{business.address}</p>
      </div>
      <div>
        <h2>Hoạt động</h2><p>{business.openingHours}</p><p>
          {business.serviceArea}
        </p>
      </div>
      <div id="privacy">
        <h2>Quyền riêng tư</h2><p>
          Họ tên, số điện thoại và nội dung yêu cầu được chuyển qua Telegram cho {
            business.legalName
          } để liên hệ lại. Dữ liệu không dùng để bán hoặc quảng cáo cho bên thứ ba.
          Khách có thể gọi một trong hai số trên để yêu cầu sửa hoặc xóa thông tin.
        </p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>
        © {new Date().getFullYear()}
        {business.name}. Đơn vị vận hành: {business.legalName}.
      </p>
    </div>
  </footer>

  <div class="mobile-cta" aria-label="Liên hệ nhanh">
    <a
      href={business.contacts[0].zaloUrl}
      target="_blank"
      rel="noopener noreferrer">Zalo 1</a
    >
    <a
      href={business.contacts[1].zaloUrl}
      target="_blank"
      rel="noopener noreferrer">Zalo 2</a
    >
    <a href="#quote">Báo giá</a>
  </div>

  <dialog
    id="gallery-dialog"
    class="gallery-dialog"
    aria-labelledby="dialog-title"
  >
    <div class="dialog-header">
      <h2 id="dialog-title">Ảnh sản phẩm</h2><button
        type="button"
        data-dialog-close
        aria-label="Đóng ảnh">×</button
      >
    </div>
    <img src="" alt="" width="960" height="960" />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#gallery-dialog");
    const dialogImage = dialog?.querySelector<HTMLImageElement>("img");
    document
      .querySelectorAll<HTMLButtonElement>("[data-lightbox-src]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          if (!dialog || !dialogImage) return;
          dialogImage.src = button.dataset.lightboxSrc ?? "";
          dialogImage.alt = button.dataset.lightboxAlt ?? "Ảnh sản phẩm";
          dialog.showModal();
        });
      });
    dialog
      ?.querySelector<HTMLButtonElement>("[data-dialog-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>
