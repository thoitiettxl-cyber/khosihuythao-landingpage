---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { business, hasBusinessPlaceholders } from "../config/business";
import { categories } from "../data/categories";
import { faq } from "../data/faq";
import { products } from "../data/products";
import { orderSteps } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase } from "../utils/config";

const title = `${business.name} | Vật tư công trình TP.HCM`;
const description =
  "Kho sỉ vật tư công trình, lưỡi cắt, băng keo và dụng cụ sơn tại TP.HCM. Nhận tại kho hoặc giao chành xe toàn quốc.";
const isRemoteImage = (image: string) =>
  image.startsWith("https://") || image.startsWith("http://");
const lightboxSrc = (image: string) =>
  isRemoteImage(image)
    ? image
    : joinBase(import.meta.env.BASE_URL, `/images/${image}-960.webp`);
const primary = business.contacts[0];
const structuredData = [
  {
    "@type": "FAQPage",
    "@id": `${business.siteUrl}/#faq`,
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${business.siteUrl}/#products`,
    name: "Mặt hàng vật tư tại Kho Sỉ Huy Thảo",
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        description: product.use,
        image: isRemoteImage(product.image)
          ? product.image
          : `${business.siteUrl}/images/${product.image}-960.webp`,
        url: `${business.siteUrl}/#products`,
      },
    })),
  },
];
---

<BaseLayout {title} {description} {structuredData}>
  {
    hasBusinessPlaceholders && (
      <div class="preview-banner" role="status">
        Bản xem trước — thông tin liên hệ thật chưa được cấu hình, không dùng để
        đặt hàng production.
      </div>
    )
  }
  <header class="site-header">
    <div class="container header-inner">
      <a
        class="brand"
        href="#top"
        aria-label={`${business.name} — về đầu trang`}
      >
        <span class="brand-mark" aria-hidden="true">HT</span>
        <span
          ><strong>{business.name}</strong><small>{business.slogan}</small
          ></span
        >
      </a>
      <nav class="primary-nav" aria-label="Mục trang">
        <a href="#categories">Nhóm hàng</a>
        <a href="#products">Hàng thực tế</a>
        <a href="#faq">Hỏi đáp</a>
      </nav>
      <div class="header-actions">
        <a class="button button-accent" href={primary.phoneHref}
          >Gọi {primary.phoneDisplay}</a
        >
      </div>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1>
            <span class="hero-line">Kho sỉ vật tư công trình</span>
            <span class="hero-line hero-line-soft">Dụng cụ sơn tại TP.HCM</span>
          </h1>
          <p class="hero-lead">
            Lưỡi cắt, băng keo, cọ sơn và dụng cụ. Gọi số trên trang — kho đối
            chiếu hàng thật rồi báo giá.
          </p>
          <div class="hero-contact">
            <p class="hero-contact-label">Gọi kho</p>
            <div class="hero-actions">
              {
                business.contacts.map((contact) => (
                  <a
                    class="button button-accent button-large"
                    href={contact.phoneHref}
                  >
                    Gọi {contact.phoneDisplay}
                  </a>
                ))
              }
            </div>
            <p class="hero-zalo">
              {
                business.contacts.map((contact) => (
                  <a
                    class="text-link"
                    href={contact.zaloUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Zalo {contact.phoneDisplay}
                  </a>
                ))
              }
            </p>
          </div>
        </div>
        <div class="hero-visual">
          <figure class="hero-shot hero-shot-main">
            <ResponsiveImage
              image="03-warehouse-cartons-x2000"
              alt="Các thùng vật tư X2000 trong kho"
              eager
              sizes="(max-width: 760px) 92vw, 46vw"
            />
          </figure>
          <figure class="hero-shot hero-shot-side">
            <ResponsiveImage
              image="01-kenssman-diamond-blade-105"
              alt="Lưỡi cắt kim cương 105 mm tại kho"
              sizes="(max-width: 760px) 42vw, 22vw"
            />
          </figure>
          <p class="hero-badge">
            <strong>Hàng tại kho</strong>
            <span>Liên hệ trước khi đến lấy hàng</span>
          </p>
        </div>
      </div>
    </section>

    <p class="warehouse-line">
      <span class="container warehouse-line-inner">
        <strong>{business.address}</strong>
        <span>{business.openingHours}</span>
        <span>{business.serviceArea}</span>
      </span>
    </p>

    <section
      id="categories"
      class="section catalog-section"
      aria-labelledby="categories-title"
    >
      <div class="container">
        <div class="section-heading">
          <h2 id="categories-title">Vật tư cho thợ và công trình</h2>
          <p>
            Kho tại {business.address}. Mua sỉ, nhận tại kho hoặc giao chành xe
            toàn quốc.
          </p>
        </div>
        <div class="category-grid">
          {
            categories.map((category) => (
              <article class="category-card">
                <div class="category-image">
                  <ResponsiveImage
                    image={category.image}
                    alt={`${category.name} tại Kho Sỉ Huy Thảo`}
                  />
                </div>
                <div class="card-body">
                  <h3>{category.name}</h3>
                  <p>{category.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="products"
      class="section catalog-section"
      aria-labelledby="products-title"
    >
      <div class="container">
        <div class="section-heading">
          <h2 id="products-title">Một số mặt hàng thực tế</h2>
          <p>
            Ảnh hàng đang có tại kho. Không hiện giá trên trang. Bấm ảnh để
            phóng to, rồi gọi số trên trang.
          </p>
        </div>
        <div class="product-grid">
          {
            products.map((product) => (
              <article class="product-card">
                <button
                  class="product-shot"
                  type="button"
                  data-lightbox-src={lightboxSrc(product.image)}
                  data-lightbox-alt={product.name}
                  aria-label={`Mở ảnh lớn: ${product.name}`}
                >
                  <ResponsiveImage image={product.image} alt={product.name} />
                  <span>
                    Xem ảnh <span aria-hidden="true">↗</span>
                  </span>
                </button>
                <div class="card-body">
                  <h3>{product.name}</h3>
                  <p>{product.use}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="deal"
      class="section deal-section"
      aria-labelledby="deal-title"
    >
      <div class="container">
        <div class="section-heading">
          <h2 id="deal-title">Gọi kho rồi nhận hàng</h2>
          <p>Không tài khoản, không thanh toán trên trang.</p>
        </div>
        <ol class="deal-steps">
          {
            orderSteps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-title" id="faq">
      <div class="container faq-layout">
        <div>
          <h2 id="faq-title">Thông tin trước khi liên hệ</h2>
        </div>
        <div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="brand brand-footer" href="#top"
          ><span class="brand-mark" aria-hidden="true">HT</span><span
            ><strong>{business.name}</strong><small>{business.slogan}</small
            ></span
          ></a
        >
        <p>{business.legalName}</p>
        <p>Kho sỉ vật tư — phục vụ nhanh gọn.</p>
      </div>
      <div>
        <h2>Liên hệ</h2>
        {
          business.contacts.map((contact) => (
            <p class="footer-contact">
              <a href={contact.phoneHref}>Gọi {contact.phoneDisplay}</a>
              <a
                href={contact.zaloUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Zalo {contact.phoneDisplay}
              </a>
            </p>
          ))
        }
        <p>{business.address}</p>
      </div>
      <div>
        <h2>Hoạt động</h2>
        <p>{business.openingHours}</p>
        <p>{business.serviceArea}</p>
      </div>
      <div id="privacy">
        <h2>Quyền riêng tư</h2>
        <p>
          Trang không thu form liên hệ. Số điện thoại và Zalo trên trang dùng để
          khách chủ động gọi {business.legalName}. Không bán dữ liệu cho bên thứ
          ba.
        </p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>
        © {new Date().getFullYear()}
        {business.name}. Đơn vị vận hành: {business.legalName}.
      </p>
    </div>
  </footer>

  <div class="mobile-cta" aria-label="Liên hệ nhanh">
    {
      business.contacts.map((contact) => (
        <a class="call" href={contact.phoneHref}>
          Gọi {contact.phoneDisplay}
        </a>
      ))
    }
  </div>

  <dialog
    id="gallery-dialog"
    class="gallery-dialog"
    aria-labelledby="dialog-title"
  >
    <div class="dialog-header">
      <h2 id="dialog-title">Ảnh sản phẩm</h2>
      <button type="button" data-dialog-close aria-label="Đóng ảnh">×</button>
    </div>
    <img
      src="/images/03-warehouse-cartons-x2000-960.webp"
      alt=""
      width="960"
      height="960"
    />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#gallery-dialog");
    const dialogImage = dialog?.querySelector<HTMLImageElement>("img");
    const idleLightboxSrc = "/images/03-warehouse-cartons-x2000-960.webp";
    document
      .querySelectorAll<HTMLButtonElement>("[data-lightbox-src]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          if (!dialog || !dialogImage) return;
          dialogImage.src = button.dataset.lightboxSrc ?? idleLightboxSrc;
          dialogImage.alt = button.dataset.lightboxAlt ?? "Ảnh sản phẩm";
          dialog.showModal();
        });
      });
    dialog
      ?.querySelector<HTMLButtonElement>("[data-dialog-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener("close", () => {
      if (!dialogImage) return;
      dialogImage.src = idleLightboxSrc;
      dialogImage.alt = "";
    });
  </script>
</BaseLayout>
